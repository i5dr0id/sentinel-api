# Copy to .env and export, or set SENTINEL_* variables directly.
SENTINEL_LOG_LEVEL=info

# Store: "memory" runs the simulator with zero infrastructure.
SENTINEL_STORE_KIND=memory
# Switch to "postgres" for production:
# SENTINEL_STORE_KIND=postgres
# SENTINEL_STORE_DATABASE_URL=postgres://sentinel:change-me@localhost:5432/sentinel

# Optional bearer token for POST /api/v1/ingest
# SENTINEL_INGEST_TOKEN=

# Log tailing (empty = disabled). Asset applies to all tailed paths.
# SENTINEL_TAIL_PATHS=/var/log/nginx/access.log,/var/log/auth.log
# SENTINEL_TAIL_ASSET=api-gw-01
